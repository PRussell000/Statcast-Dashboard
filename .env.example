# Copy to .env (never commit .env). All values are optional.

# Slack or Discord incoming-webhook URL for failure alerts
ALERT_WEBHOOK_URL=

# Use MotherDuck as the warehouse instead of the local DuckDB file:
# WAREHOUSE_PATH=md:statcast
# MOTHERDUCK_TOKEN=

# Run the DAGs on generated sample data (offline demo)
# STATCAST_SAMPLE=1

# Linux only: your user id, so files Airflow writes are owned by you (`id -u`)
# AIRFLOW_UID=1000
